{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent-workshop/schemas/skills/powerful-tier-manifest.schema.json",
  "title": "POWERFUL Tier Skill Manifest Entry",
  "type": "object",
  "required": ["skill", "phase", "source_path", "import_mode", "maturity", "status"],
  "properties": {
    "skill": { "type": "string" },
    "phase": { "type": "integer", "minimum": 0 },
    "source_path": { "type": "string" },
    "import_mode": { "type": "string" },
    "maturity": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["planned", "scaffolded", "implemented", "blocked"]
    },
    "upstream_license": { "type": "string" },
    "notes": { "type": "string" }
  }
}
