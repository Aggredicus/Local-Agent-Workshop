{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aggredicus/Local-Agent-Workshop/schemas/dashboard_projection.schema.json",
  "title": "Local Agent Workshop Dashboard Projection",
  "description": "Generated deterministic dashboard projection for first-glance agent guidance. This artifact is a projection and must not override source-of-truth layers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_by",
    "generated_at",
    "projection_notice",
    "graph_ref",
    "summary",
    "filters",
    "next_actions",
    "cards",
    "development_packets",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "artifact_type": {
      "const": "dashboard_projection"
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "projection_notice": {
      "type": "string",
      "minLength": 1,
      "description": "Must state that the dashboard is generated from source artifacts and is not itself a source of truth."
    },
    "graph_ref": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "filters": {
      "$ref": "#/$defs/filters"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dashboard_card"
      }
    },
    "development_packets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/development_packet"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "verdict": {
      "type": "string",
      "enum": [
        "ready",
        "ready_for_autonomous_merge",
        "ready_for_human_approval",
        "needs_authorization_note",
        "human_gated",
        "needs_human_review",
        "blocked",
        "missing_context",
        "missing_schema",
        "missing_evidence",
        "needs_spec",
        "stack_wait",
        "duplicate",
        "stale",
        "superseded",
        "risky",
        "complete_candidate",
        "unknown"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "documenter",
        "schema-builder",
        "tester",
        "reviewer",
        "operator",
        "project-manager",
        "security-reviewer"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_count",
        "blocked_count",
        "human_gated_count",
        "missing_evidence_count",
        "stale_count",
        "top_recommendation"
      ],
      "properties": {
        "ready_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "human_gated_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "stale_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_recommendation": {
          "type": "string"
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "timeline_modes", "verdicts"],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          },
          "uniqueItems": true
        },
        "timeline_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["issue_number", "implementation_phase", "commit_history", "risk_class", "readiness_verdict"]
          },
          "uniqueItems": true
        },
        "verdicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verdict"
          },
          "uniqueItems": true
        },
        "range_selectors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": {
                "type": ["integer", "number", "string"]
              },
              "max": {
                "type": ["integer", "number", "string"]
              }
            }
          }
        }
      }
    },
    "reason_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "evidence"],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "title", "verdict", "role", "next_action", "reason_chain"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_chain": {
          "$ref": "#/$defs/reason_chain"
        },
        "development_packet_ref": {
          "type": "string"
        }
      }
    },
    "dashboard_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "target", "verdict", "reason_chain"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "risk": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "critical", "unknown"]
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "planned_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_chain": {
          "$ref": "#/$defs/reason_chain"
        }
      }
    },
    "development_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "objective",
        "recommended_role",
        "dependencies",
        "allowed_paths",
        "forbidden_paths",
        "required_outputs",
        "required_evidence",
        "next_action",
        "stop_conditions",
        "human_decision_points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "recommended_role": {
          "$ref": "#/$defs/role"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_decision_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["info", "warn", "blocker", "escalate"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
