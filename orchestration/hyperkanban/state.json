{
  "schema_version": "0.1.0",
  "project": {
    "name": "Local Agent Workshop",
    "purpose": "Operational project-state topology for agentic orchestration. Chronicle events remain the long-term source of truth; this file is the current working projection."
  },
  "rank": 8,
  "axes": [
    {
      "key": "ring",
