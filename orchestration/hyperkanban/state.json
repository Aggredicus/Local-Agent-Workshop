      "default": "backlog",
      "values": ["backlog", "ready", "active", "review", "done", "blocked"],
      "role": "workflow"
    },
    {
      "key": "shell",
      "name": "Orbital shell",
      "type": "integer",
      "default": 0,
      "values": [0, 1, 2, 3, 4, 5, 6, 7],
      "role": "nesting_depth"
    },
    {
      "key": "slot",
      "name": "Octet slot",
      "type": "integer",
      "default": 0,
      "values": [0, 1, 2, 3, 4, 5, 6, 7],
      "role": "octet_position"
    },
    {
      "key": "branch",
      "name": "Version branch",
      "type": "integer",
      "default": 0,
      "values": [0, 1, 2, 3, 4, 5, 6, 7],
      "role": "timeline"
    },
    {
      "key": "realm",
      "name": "Realm",
      "type": "enum",
      "default": "Core",
      "values": ["Core", "Governance", "Runtime", "Schemas", "QA", "Docs", "Integrations", "Future"],
